create_launch_emulator_test(
    name = "can_launch_kernel_with_minigbm",
    params = [
        "-show-kernel",
        "-no-boot-anim",
    ],
    target_log_line = "'Linux version 6'",
    timeout_seconds = 30,
)

create_launch_emulator_test(
    name = "can_boot_with_minigbm",
    count_log_pattern = "'Gfxstream initialized successfully!'",
    expected_occurrences = 1,
    params = [
        "-show-kernel",
        "-no-boot-anim",
        # Increase netsimd's initial device connection timeout from the 15s
        # default so slower debug/ASAN builds (e.g. during software Vulkan ICD
        # initialization on headless CI runners) do not time out before QEMU
        # attaches to netsimd.
        "-netsim-startup-timeout",
        "30s",
    ],
    target_log_line = "'Boot completed in \\d+ ms'",
    timeout_seconds = 300,
)

create_launch_emulator_test(
    # Same boot with the plugin's virtio-gpu-gfxstream device instead of the
    # default virtio-gpu-rutabaga (b/576450291). x-verify-state=enforce is not
    # passed because the launcher owns the -device string; the device's default
    # "log" mode reports invariant violations in the emulator log.
    name = "can_boot_with_gfxstream_device",
    count_log_pattern = "'Using virtio-gpu device: virtio-gpu-gfxstream'",
    expected_occurrences = 1,
    params = [
        "-show-kernel",
        "-no-boot-anim",
        "-virtio-gpu-device",
        "gfxstream",
        "-netsim-startup-timeout",
        "30s",
    ],
    target_log_line = "'Boot completed in \\d+ ms'",
    timeout_seconds = 300,
)

create_launch_emulator_test(
    # This tests validates that the we receive at least a series frames from the guest.
    name = "emulator_produces_pixels",
    params = [
        "-vmodule",
        "'pixman_display=2'",
    ],
    target_log_line = "'UpdateSurface Display: 0 \\(1080x2400\\), seq: 25'",
    timeout_seconds = 300,
)

create_launch_emulator_test(
    name = "can_boot_with_minigbm_2x",
    params = [
        "-show-kernel",
        "-no-boot-anim",
    ],
    repeat = 1,
    target_log_line = "'Boot completed in \\d+ ms'",
    timeout_seconds = 300,
)

