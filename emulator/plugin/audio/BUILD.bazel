# buildifier: leave-alone
cc_binary(
    name = "qtest_audio_inject_plugin",
    testonly = True,
    srcs = ["qtest_audio_inject_plugin.cc"],
    copts = WEBRTC_COPTS,
    dynamic_deps = [
        "@glib//glib:glib_shared",
        "@glib//gmodule:gmodule_shared",
    ],
    linkshared = True,
    target_compatible_with = QTEST_TARGET_COMPATIBLE_WITH,
    linkopts = select({
        "@platforms//os:macos": ["-undefined dynamic_lookup"],
        "//conditions:default": [],
    }),
    deps = [
        ":goldfish_audio_mux",
        ":pcm_format",
        ":qemu_audio_inject",
        "@abseil-cpp//absl/status",
        "@glib//glib:glib_import",
        "@glib//gmodule:gmodule_import",
        "@qemu//:aemu_func_defs",
        "@qemu//:qemu-headers-exported",
    ],
)

# Mirrors qemu_qtest() from @qemu//:google/build/qtest.bzl. The macro itself
# cannot be called from @goldfish yet because it depends on @qemu//:qemu-headers
# (private to @qemu) rather than @qemu//:qemu-headers-exported.
cc_test(
    name = "virtio_snd_inject_qtest",
    size = "small",
    srcs = ["virtio_snd_inject_qtest.c"],
    args = [
        "--tap",
        "-k",
    ],
    copts = QTEST_COPTS,
    data = [
        ":qtest_audio_inject_plugin",
        "@qemu//:goldfish_x86_64",
        "@qemu//:qemu-img",
        "@qemu//:qemu-keymaps",
        "@qemu//:qemu-system-x86_64",
        "@qemu//:qtest-roms",
    ],
    dynamic_deps = [
        "@glib//glib:glib_shared",
        "@glib//gmodule:gmodule_shared",
    ],
    env = {
        "ASAN_OPTIONS": "detect_leaks=0",
        "QTEST_GOLDFISH_EXTRA_PLUGIN": "$(rootpath :qtest_audio_inject_plugin)",
        "QTEST_GOLDFISH_PLUGIN": "$(rootpath @qemu//:goldfish_x86_64)",
        "QTEST_QEMU_BINARY": "$(rootpath @qemu//:qemu-system-x86_64)",
        "QTEST_QEMU_IMG": "$(rootpath @qemu//:qemu-img)",
    },
    linkopts = select({
        "@platforms//os:macos": [
            "-framework CoreFoundation",
            "-framework IOKit",
        ],
        "@goldfish_build//platforms:is_linux_aarch64": ["-lrt"],
        "@goldfish_build//platforms:is_linux_x64": ["-lrt"],
        "//conditions:default": [],
    }),
    linkstatic = True,
    local_defines = QTEST_LOCAL_DEFINES,
    target_compatible_with = QTEST_TARGET_COMPATIBLE_WITH,
    deps = [
        "@qemu//:libprintstub",
        "@qemu//:libqemuutil",
        "@qemu//:libqom",
        "@qemu//:libqos",
        "@qemu//:qemu-headers-exported",
    ] + select({
        "@goldfish_build//platforms:is_linux_x64": [
            "@qemu//google/compat/linux:compat",
        ],
        "//conditions:default": [],
    }),
)

