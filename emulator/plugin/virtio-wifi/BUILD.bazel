load("@aemu//tools/clang_tidy:defs.bzl", "clang_tidy_test")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_license//rules:license.bzl", "license")
load("@rules_license//rules:license_kind.bzl", "license_kind")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    package_name = "virtio-wifi",
    license_kinds = [
        ":SPDX-license-identifier-GPL-2.0-only",
    ],
    package_url = "https://android.googlesource.com/platform/hardware/generic/goldfish/",
    visibility = [":__subpackages__"],
)

license_kind(
    name = "SPDX-license-identifier-GPL-2.0-only",
    conditions = ["notice"],
    url = "https://spdx.org/licenses/GPL-2.0-only.html",
)

cc_library(
    name = "virtio-wifi",
    srcs = ["virtio_wifi.c"],
    hdrs = ["include/goldfish/net/virtio_wifi.h"],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "//emulator/libs/logging:absl_c_bridge",
        "@qemu//:qemu-headers-exported",
    ],
)

cc_test(
    name = "virtio_wifi_test",
    size = "small",
    srcs = ["virtio_wifi_test.cc"],
    deps = [
        ":virtio-wifi",
        "//emulator/libs/test:googletest_main",
        "@glib//glib",
        "@glib//gmodule",
        "@googletest//:gtest",
        "@qemu//:qemu-headers-exported",
    ],
)

clang_tidy_test(
    name = "tidy",
    targets = [
        ":virtio_wifi_test",
    ],
    tidy_config_file = "//:clang_tidy_config",
)
