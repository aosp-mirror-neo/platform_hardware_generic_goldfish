load("@aemu//tools/clang_tidy:defs.bzl", "clang_tidy_test")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

clang_tidy_test(
    name = "tidy",
    targets = [
        ":goldfish_pipe",
        ":goldfish_pipe_test",
    ],
    tidy_config_file = "//:clang_tidy_config",
)

cc_library(
    name = "goldfish_pipe",
    srcs = [
        "goldfish_pipe.cc",
    ],
    hdrs = [
        "goldfish_pipe.h",
    ],
    deps = [
        "//emulator/libs/SocketBuffer",
        "//emulator/libs/archive",
        "//emulator/libs/archive:DequeArchive",
        "//emulator/libs/archive:QEMUFileArchive",
        "//emulator/plugin/legacy/common",
        "//emulator/plugin/legacy/goldfish_gpu",
        "@abseil-cpp//absl/base:core_headers",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/synchronization",
    ],
    alwayslink = True,
)

cc_library(
    name = "impl",
    srcs = [
        "goldfish_pipe_low_level.c",
    ],
    hdrs = ["include/goldfish/legacy/goldfish_pipe_low_level.h"],
    includes = ["include"],
    deps = [
        ":goldfish_pipe",
        "//emulator/plugin/legacy/common:c_hdrs",
        "//emulator/plugin/legacy/goldfish_gpu:impl",
        "@pixman//:pixman-1",
        "@qemu//:aemu_func_defs",
        "@qemu//:qemu-headers-exported",
    ],
    alwayslink = True,
)

[
    alias(
        name = "impl_" + arch,
        actual = ":impl",
    )
    for arch in [
        "aarch64",
        "x86_64",
    ]
]

cc_test(
    name = "goldfish_pipe_test",
    srcs = ["goldfish_pipe_test.cc"],
    deps = [
        ":goldfish_pipe",
        "//emulator/libs/archive",
        "//emulator/libs/archive:DequeArchive",
        "//emulator/libs/status_macros:status_matcher_macros",
        "//emulator/libs/test:googletest_main",
        "//emulator/plugin/legacy/common",
        "//emulator/plugin/legacy/common:fake_guest_memory",
        "//emulator/plugin/legacy/goldfish_gpu",
        "//emulator/plugin/legacy/goldfish_gpu:fake_goldfish_gpu",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@googletest//:gtest",
    ],
)
