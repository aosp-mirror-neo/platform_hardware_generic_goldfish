load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "goldfish_sync",
    srcs = [
        "goldfish_sync.cc",
    ],
    hdrs = [
        "goldfish_sync.h",
    ],
    deps = [
        "//emulator/libs/archive",
        "//emulator/libs/archive:QEMUFileArchive",
        "//emulator/plugin/legacy/common",
        "//emulator/plugin/legacy/goldfish_gpu",
        "@abseil-cpp//absl/base:core_headers",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@abseil-cpp//absl/synchronization",
    ],
    alwayslink = True,
)

cc_library(
    name = "impl",
    srcs = [
        "goldfish_sync_low_level.c",
    ],
    hdrs = ["include/goldfish/legacy/goldfish_sync_low_level.h"],
    includes = ["include"],
    deps = [
        ":goldfish_sync",
        "//emulator/plugin/legacy/common:c_hdrs",
        "@qemu//:aemu_func_defs",
        "@qemu//:qemu-headers-exported",
    ],
    alwayslink = True,
)

[
    alias(
        name = "impl_" + arch,
        actual = ":impl",
    )
    for arch in [
        "aarch64",
        "x86_64",
    ]
]

cc_test(
    name = "goldfish_sync_test",
    srcs = ["goldfish_sync_test.cc"],
    deps = [
        ":goldfish_sync",
        "//emulator/libs/archive:DequeArchive",
        "//emulator/libs/status_macros:status_matcher_macros",
        "//emulator/libs/test:googletest_main",
        "//emulator/plugin/legacy/common",
        "//emulator/plugin/legacy/common:fake_guest_memory",
        "//emulator/plugin/legacy/goldfish_gpu",
        "//emulator/plugin/legacy/goldfish_gpu:fake_goldfish_gpu",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:status_matchers",
        "@abseil-cpp//absl/status:statusor",
        "@googletest//:gtest",
    ],
)
