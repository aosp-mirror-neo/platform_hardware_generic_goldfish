load("@aemu//tools/clang_tidy:defs.bzl", "clang_tidy_test")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

# Snapshot state and formats: the kRunning/kQuiesced/kSaved/kPreLoaded phase tracker, the
# VMState meta-blob codec, the gfxstream_render.bin / gfxstream_textures.bin files and their
# gfxstream::Stream adapters, and the last posted frame that is saved and replayed.
# Nothing here changes the wire format without a version bump in gpu_snapshot_codec.

package(
    default_applicable_licenses = ["//emulator:license"],
    default_visibility = ["//visibility:public"],
)

cc_library(
    name = "snapshot_streams",
    srcs = ["snapshot_streams.cc"],
    hdrs = ["include/goldfish/legacy/goldfish_gpu/snapshot/snapshot_streams.h"],
    includes = ["include"],
    deps = [
        "@abseil-cpp//absl/base:core_headers",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/synchronization",
        "@gfxstream//host:gfxstream_backend_headers",
    ],
)

cc_test(
    name = "snapshot_streams_test",
    size = "small",
    srcs = ["snapshot_streams_test.cc"],
    deps = [
        ":snapshot_streams",
        "//emulator/libs/status_macros:status_matcher_macros",
        "//emulator/libs/system:test-headers",
        "//emulator/libs/test:googletest_main",
        "@abseil-cpp//absl/status",
        "@gfxstream//host:gfxstream_backend_headers",
        "@googletest//:gtest",
    ],
)

cc_library(
    name = "gpu_snapshot_codec",
