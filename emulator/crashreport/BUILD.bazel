load("@aemu//tools/clang_tidy:defs.bzl", "clang_tidy_test")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//emulator/tools:cc_binary_with_manifest.bzl", "cc_binary_with_manifest")

config_setting(
    name = "opt",
    values = {"compilation_mode": "opt"},
)

# Select crash report upload URL based on build type. Staging URL is used by default,
# and production URL is used for release (opt) builds.
CRASHURL_DEFINES = select({
    ":opt": [
        'CRASHURL=\\"https://clients2.google.com/cr/report\\"',
    ],
    "//conditions:default": [
        'CRASHURL=\\"https://clients2.google.com/cr/staging_report\\"',
    ],
})

cc_library(
    name = "debug",
    srcs = ["debug.cc"],
    hdrs = ["include/android/crashreport/debug.h"],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "//emulator/libs/file",
    ],
)

