load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load(":packaging.bzl", "aemu_naming")
load(":version_info.bzl", "version_info_header")

package(
    default_visibility = ["//visibility:public"],
)

config_setting(
    name = "dbg",
    values = {"compilation_mode": "dbg"},
)

config_setting(
    name = "opt",
    values = {"compilation_mode": "opt"},
)

config_setting(
    name = "asan",
    values = {"features": "asan"},
)

config_setting(
    name = "tsan",
    values = {"features": "tsan"},
)

py_binary(
    name = "symbol_zipper",
    srcs = ["symbol_zipper.py"],
)

py_test(
    name = "symbol_zipper_test",
    size = "small",
    srcs = ["symbol_zipper_test.py"],
    data = ["symbol_zipper.py"],
    deps = [
        ":symbol_zipper",
    ],
)

py_binary(
    name = "generate_notice",
    srcs = ["generate_notice.py"],
)

py_binary(
    name = "generate_sbom",
    srcs = ["generate_sbom.py"],
)

py_test(
    name = "generate_sbom_test",
    size = "small",
    srcs = ["generate_sbom_test.py"],
    deps = [
        ":generate_sbom",
    ],
)

aemu_naming(
    name = "aemu_header_version_info",
    description = "Android Emulator (Preview)",
    platform = select({
        "@goldfish_build//platforms:is_linux_aarch64": "linux_aarch64",
        "@goldfish_build//platforms:is_windows_aarch64": "windows_aarch64",
        "@platforms//os:windows": "windows",
        "@platforms//os:macos": "darwin_aarch64",
        "@platforms//os:linux": "linux",
        "//conditions:default": "unknown",
    }),
    product_name = select({
        "//conditions:default": "emulator",
        ":dbg": "emulator-debug",
        ":opt": "emulator",
    }),
    stage = "",
    version = "37.1.8",
)

aemu_naming(
    name = "aemu_version_info",
    build_id_dep = "//emulator:build_id",
    description = "Android Emulator (Preview)",
    platform = select({
        "@goldfish_build//platforms:is_linux_aarch64": "linux_aarch64",
        "@goldfish_build//platforms:is_windows_aarch64": "windows_aarch64",
        "@platforms//os:windows": "windows",
        "@platforms//os:macos": "darwin_aarch64",
        "@platforms//os:linux": "linux",
        "//conditions:default": "unknown",
    }),
    product_name = select({
        "//conditions:default": "emulator",
        ":dbg": "emulator-debug",
        ":opt": "emulator",
    }),
    stage = "",
    version = "37.1.8",
)

version_info_header(
    name = "version_info",
    outs = "aemu_version.h",
    template = "version_template.h.in",
    version_info = ":aemu_header_version_info",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "aemu_version",
    srcs = ["aemu_version.cc"],
    hdrs = [":version_info"],
    include_prefix = "goldfish/tools",
    linkstamp = "aemu_linkstamp.cc",
    visibility = ["//visibility:public"],
)

cc_test(
    name = "aemu_version_test",
    size = "small",
    srcs = ["aemu_version_test.cc"],
    deps = [
        ":aemu_version",
        "//emulator/libs/test:googletest_main",
    ],
)
