load("@aemu//tools/clang_tidy:defs.bzl", "clang_tidy_test")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "fps_calculator",
    srcs = ["fps_calculator.cc"],
    hdrs = [
        "include/goldfish/fps_calculator.h",
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "@abseil-cpp//absl/time",
    ],
)

cc_test(
    name = "fps_calculator_unittests",
    size = "small",
    srcs = ["fps_calculator_test.cc"],
    visibility = ["//visibility:public"],
    deps = [
        ":fps_calculator",
        "//emulator/libs/test:googletest_main",
    ],
)

clang_tidy_test(
    name = "tidy",
    targets = [
        ":fps_calculator",
        ":fps_calculator_unittests",
    ],
    tidy_config_file = "//:clang_tidy_config",
)
