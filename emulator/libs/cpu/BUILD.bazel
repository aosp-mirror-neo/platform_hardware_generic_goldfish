load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "x86_cpuid",
    srcs = ["x86_cpuid.cc"],
    hdrs = ["x86_cpuid.h"],
    tags = ["no-tidy"],
    deps = ["//emulator/libs/system"],
)

cc_test(
    name = "x86_cpuid_test",
    size = "small",
    srcs = ["x86_cpuid_test.cc"],
    target_compatible_with = ["@platforms//cpu:x86_64"],
    deps = [
        ":x86_cpuid",
        "//emulator/libs/test:googletest_main",
    ],
)

cc_library(
    name = "cpu_brand",
    srcs = ["cpu_brand.cc"],
    hdrs = ["include/android/cpu/cpu_brand.h"],
    includes = ["include"],
    linkopts = select({
        "@platforms//os:windows": [
            "-defaultlib:wbemuuid.lib",
            "-defaultlib:oleaut32.lib",
            "-defaultlib:ole32.lib",
        ],
        "//conditions:default": [],
    }),
    tags = ["no-tidy"],
    visibility = ["//visibility:public"],
    deps = [":x86_cpuid"] + select({
        "@platforms//os:windows": [
            "//emulator/libs/windows:scoped_com_initializer",
        ],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "version",
    srcs = ["version.cc"],
    hdrs = ["include/android/cpu/version.h"],
    includes = ["include"],
    tags = ["no-tidy"],
    visibility = ["//visibility:public"],
    deps = [
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
    ],
)

cc_library(
    name = "cpu",
    srcs = [
        "apple_cpu_accelerator.h",
        "cpu_accelerator.cc",
        "cpu_accelerator_internal.h",
        "x86_cpuid.cc",
        "x86_cpuid.h",
    ] + select({
        "@platforms//os:windows": [
            "windows_installer.cc",
            "windows_installer.h",
        ],
        "//conditions:default": [],
    }),
    hdrs = [
        "include/android/cpu/cpu_accelerator.h",
        "include/android/cpu/version.h",
    ],
    copts =
        select({
            "@platforms//os:windows": ["-Wno-microsoft-goto"],
            "//conditions:default": [],
        }),
    includes = ["include"],
    tags = ["no-tidy"],
    visibility = ["//visibility:public"],
    deps = [
        ":version",
        ":x86_cpuid",
        "//emulator/libs/file",
        "//emulator/libs/system",
        "@abseil-cpp//absl/cleanup",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
    ] + select({
        "@platforms//os:windows": [
            "//emulator/libs/windows:scoped_file_handle",
            "//emulator/libs/windows:scoped_reg_key",
            "//emulator/libs/windows:win32_utils",
        ],
        "//conditions:default": [
            "//emulator/libs/file:scoped_fd",
        ],
    }),
)

cc_test(
    name = "cpu_accelerator_test",
    size = "small",
    srcs = [
        "cpu_accelerator_internal.h",
        "cpu_accelerator_test.cc",
    ],
    linkopts = select({
        "@platforms//os:macos": ["-undefined error"],
        "//conditions:default": [],
    }),
    deps = [
        ":cpu",
        "//emulator/libs/file",
        "//emulator/libs/system",
        "//emulator/libs/system:test-headers",
        "//emulator/libs/test:googletest_main",
        "@abseil-cpp//absl/cleanup",
        "@abseil-cpp//absl/strings",
    ] + select({
        "@platforms//os:windows": [
            "//emulator/libs/windows:win32_utils",
        ],
        "//conditions:default": [],
    }),
)

cc_test(
    name = "version_test",
    size = "small",
    srcs = ["version_test.cc"],
    linkopts = select({
        "@platforms//os:macos": ["-undefined error"],
        "//conditions:default": [],
    }),
    deps = [
        ":cpu",
        "//emulator/libs/system:test-headers",
        "//emulator/libs/test:googletest_main",
    ],
)
